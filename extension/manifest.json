{
  "manifest_version": 3,
  "name": "Grabit",
  "version": "1.0.0",
  "description": "Export AI conversations to PDF, Markdown, HTML, and more — beautifully.",

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "identity"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://api.lemonsqueezy.com/*",
    "https://api.notion.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "content-scripts/scraper-utils.js",
        "content-scripts/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content-scripts/scraper-utils.js",
        "content-scripts/claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "content-scripts/scraper-utils.js",
        "content-scripts/gemini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": [
        "content-scripts/scraper-utils.js",
        "content-scripts/grok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content-scripts/sidebar-inject.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Grabit",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ]
    }
  ]
}
